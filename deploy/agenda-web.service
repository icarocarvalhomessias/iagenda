# Exemplo de serviço systemd. Ajuste o domínio, os caminhos e o usuário ao seu servidor.
[Unit]
Description=agenda-web (IAgenda para convidados)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenda-web
Group=agenda-web
WorkingDirectory=/opt/agenda-web
ExecStart=/usr/local/bin/node /opt/agenda-web/servidor.ts
Restart=always
RestartSec=5
Environment=TZ=America/Sao_Paulo
# Escuta só em rede interna; o proxy reverso (Caddy, nginx) põe o HTTPS na frente.
Environment=AGENDA_HOST=127.0.0.1
Environment=AGENDA_PORTA=8091
Environment=AGENDA_PROXY=1
# Endereço público. O retorno do login é AGENDA_SITE + /auth/google/retorno (cadastre igual no Google Cloud).
Environment=AGENDA_SITE=https://agenda.example.com
# Cliente OAuth do Google (tipo "Aplicativo da Web"). O segredo e a chave mestra vêm por LoadCredential: o systemd
# lê como root e entrega só a este processo (em $CREDENTIALS_DIRECTORY); os arquivos de origem continuam só do root.
Environment=AGENDA_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
LoadCredential=google-client-secret:/etc/agenda-web/google-client-secret
# Chave que cifra os refresh tokens no banco (32 bytes: openssl rand -base64 32). Fora da pasta de dados.
LoadCredential=chave-mestra:/etc/agenda-web/chave-mestra
# Quem pode entrar, além dos convites feitos com `node admin.ts convidar` (* abre para qualquer conta Google).
Environment=AGENDA_CONVITES=
# Chave da API da Anthropic do chat. Sem ela, o chat fica desligado e a agenda segue.
# Outro provedor (README, "IA do chat"): Environment=AGENDA_IA=openai, AGENDA_MODELO=... e LoadCredential=ia-chave:...
LoadCredential=anthropic-chave:/etc/agenda-web/anthropic-chave
# Modelo e esforço do chat (chat.ts). Para baratear: AGENDA_MODELO=claude-haiku-5-5.
Environment=AGENDA_MODELO=claude-opus-5-5
Environment=AGENDA_ESFORCO=low
Environment=AGENDA_CHAT_DIA=100
StateDirectory=agenda-web
StateDirectoryMode=0700
# Pessoas, sessões, conversa do chat, remédios e avisos ficam em $STATE_DIRECTORY/agenda.db (SQLite).
# Sem sudo e sem acesso ao resto do servidor: só lê o próprio código e fala com o Google e a IA do chat.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
InaccessiblePaths=/home /root /var/backups

[Install]
WantedBy=multi-user.target
