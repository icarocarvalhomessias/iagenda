# Copie para .env e preencha. Nunca ponha o .env no git.

# ---------- endereço ----------
# Endereço público. Para testar no computador: http://127.0.0.1:8091
# Com o Caddy (docker compose --profile https): https://agenda.seudominio.com, e AGENDA_DOMINIO igual, sem https://
AGENDA_SITE=http://127.0.0.1:8091
AGENDA_DOMINIO=
# 1 quando há um proxy reverso na frente (o Caddy do compose, nginx). Sem proxy, deixe 0.
AGENDA_PROXY=0

# ---------- login com Google (README, "Login com Google") ----------
# Retorno a cadastrar no Google Cloud: AGENDA_SITE + /auth/google/retorno
AGENDA_GOOGLE_CLIENT_ID=
AGENDA_GOOGLE_CLIENT_SECRET=
# Quem pode entrar (separados por vírgula; * para qualquer conta Google). Também dá para usar:
#   docker compose exec iagenda node admin.ts convidar fulana@gmail.com
AGENDA_CONVITES=

# ---------- segurança ----------
# Cifra as autorizações do Google guardadas no banco. Gere com: openssl rand -base64 32
# Guarde também fora do servidor: sem ela, todas as pessoas precisam entrar de novo.
AGENDA_CHAVE_MESTRA=

# ---------- chat com IA (opcional) ----------
# Chave da API da Anthropic (console.anthropic.com). Vazia: o chat fica desligado e a agenda funciona.
AGENDA_ANTHROPIC_CHAVE=
AGENDA_MODELO=claude-opus-5-5
# low, medium ou high
AGENDA_ESFORCO=low
# Mensagens por pessoa por dia
AGENDA_CHAT_DIA=100

# ---------- modo demonstração (opcional; README, "Modo demonstração") ----------
# 1: "Experimentar sem conta" na tela de entrar, com uma agenda de exemplo que não vai para o Google.
AGENDA_DEMO=0
AGENDA_DEMO_HORAS=24
# Chat na demonstração: mensagens por visitante e teto do dia somando todos (é a sua chave que paga).
AGENDA_DEMO_CHAT_DIA=15
AGENDA_DEMO_CHAT_TOTAL=300

# ---------- outros ----------
TZ=America/Sao_Paulo
